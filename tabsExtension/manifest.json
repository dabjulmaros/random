{
  "manifest_version": 3,
  "name": "Tabs Explorer",
  "version": "0.1.0",
  "description": "99 Tabs and no problems",
  "icons": {
    "16": "images/emoji_16.png",
    "32": "images/emoji_32.png",
    "48": "images/emoji_48.png",
    "128": "images/emoji_128.png"
  },
  "permissions": [
    "tabGroups"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "action/popup.html"
  }
}