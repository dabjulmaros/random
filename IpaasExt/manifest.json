{
  "manifest_version": 3,
  "name": "IPAAS Better",
  "version": "1.0",
  "description": "IPAAS annoys me so this annoys me less",
  "icons": {
    "16": "images/16.png",
    "32": "images/32.png",
    "48": "images/48.png",
    "128": "images/128.png"
  },
  "content_scripts": [
    {
      "js": [
        "scripts/content.js"
      ],
      "matches": [
        "https://*.teamdynamix.com/tdapp/appdesign/*"
      ],
      "run_at": "document_end"
    }
  ]
}